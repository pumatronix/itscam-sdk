# ABI changes of libitscam_sdk accepted on purpose since compat/baseline:
# libabigail suppression specifications, read by abidiff in
# tools/compat/check-compat.sh.  Every entry needs a release note and a
# release that may break callers (docs/compatibility.md).  Example:
#
#   # 0.10.0: RestApiClientConfig gained three fields; C++ callers rebuild
#   [suppress_type]
#     name = itscam::rest_types::RestApiClientConfig

# Next release: libitscam_sdk exports only the C API and the itscam namespace
# (src/core/itscam_sdk.map).  The symbols it stopped exporting are copies of
# header-only code (libstdc++ templates, nlohmann::json, cpp-httplib) that
# every application compiles itself, so none can have bound to them.  The
# rule spares both public prefixes: removing an itscam:: or ITSCAM_ symbol
# still fails.
[suppress_function]
  change_kind = deleted-function
  name_not_regexp = ^(itscam::|ITSCAM_)

[suppress_variable]
  change_kind = deleted-variable
  name_not_regexp = ^(itscam::|ITSCAM_)

# 0.10.0: RestApiClientConfig carries every setting the camera has
# (auxCameraName, minSpeed, discardStatusCodes) and every body part type
# (Type: FORM_URLENCODED, JPEG, JSON, RAW, XML), so a get/set round trip no
# longer resets settings.  Both changed layout or values: C++ applications
# that use getRestApiClientConfig/setRestApiClientConfig must be rebuilt.
[suppress_type]
  name = itscam::rest_types::RestApiClientConfig

[suppress_type]
  name = itscam::Result<itscam::rest_types::RestApiClientConfig>

[suppress_type]
  name = itscam::rest_types::Part

[suppress_type]
  name = itscam::rest_types::Type

# 0.10.0, ARMv7 only: libabigail reads ItscamRestClient's constructor,
# destructor and clearAuthToken() from the baseline's debug info as returning
# ItscamRestClient* (the ARM EABI returns `this` from constructors).  They
# have returned void, unchanged, since v0.7.0.
[suppress_function]
  name_regexp = ^itscam::ItscamRestClient::(ItscamRestClient|~ItscamRestClient|clearAuthToken)$
